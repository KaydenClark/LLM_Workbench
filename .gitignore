# Python
__pycache__/
*.pyc

# Generated eval artifacts (regenerate with the scripts; never commit as "data")
evals/results/_pipeline_selftest.jsonl

# Real run outputs are committed deliberately, not ignored, so the ledger has
# provenance — but scratch/temp runs can be prefixed tmp_ to skip them:
evals/results/tmp_*.jsonl

# macOS
.DS_Store

# Local-only reference material (owner decides if/when to publish)
research papers/

# Linked git worktrees created for isolated review/audit checkouts
.worktrees/

# Grill Board owner answers: written by the served page only, local to the owner
workbench/grill-board/answers.json

# Local Dashboard login service output
workbench/grill-board/service.log
workbench/grill-board/service-error.log
