# Live session records stay local; only checkpoints/ is durable evidence.
# The tracked grilling-destination-audit-ledger.json at this lane's root is an
# interim home for that record while its rows become question cards.
grilling/*
!grilling/.gitkeep
handoffs/*
!handoffs/.gitkeep
# Live session records stay local; only checkpoints/ is durable evidence.
grilling/*
!grilling/.gitkeep
handoffs/*
!handoffs/.gitkeep
# Local typed notepads; reusable schema/examples remain tracked.
notepads/*
!notepads/templates/
!notepads/.gitkeep
# Legacy notepad path a stale installed skill may still write; never tracked.
grilling diary/

# Operational rollback material is local, not session history.
recovery/*
!recovery/.gitkeep
