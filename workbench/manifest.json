  "legibility": {
    "run": "node workbench/tools/spec-workbench.mjs doctor; node workbench/tools/spec-workbench.mjs next --json",
    "operate": "node workbench/tools/spec-workbench.mjs claim S-### --agent NAME; close S-### --proof TEXT; node workbench/tools/notepads.mjs; node workbench/tools/landmark-tracker.mjs",
    "inspect": "node workbench/tools/spec-workbench.mjs render; node workbench/tools/spec-workbench.mjs show S-###; TASKBOARD.md; workbench/landmark-tracker/",
    "errors": "node workbench/tools/spec-workbench.mjs doctor --json; RUNBOOK.md#test-and-build; git status --porcelain",
    "journey": "node tools/test-workbench-round-trip.mjs; node tools/test-genesis-from-decisions.mjs",
    "measure": "node tools/audit-guardrails.mjs --path .; node tools/evaluate-workbench.mjs --path . --include-controls; evals/"
  },
  "contextUnit": {
    "value": 200000,
    "unit": "tokens",
    "decisionDate": "2026-09-12",
    "source": "owner",
    "consideredAlternatives": [
      150000,
      250000
    ],
    "reason": "250k is where a context is compacted or gone while roughly 200k is where answer quality begins to degrade, and planning to the ceiling plans work into the degraded tail."
  },
