new file mode 100644
index 0000000..f79aead
--- /dev/null
+++ b/src/total.mjs
@@ -0,0 +1,6 @@
+export const sum = values => values.reduce((total, cents) => {
+  if (cents < 0) {
+    throw new RangeError('Cents must not be negative');
+  }
+  return total + cents;
+}, 0);
