+assert.equal(sum([100,200]),300);
+assert.equal(sum([]), 0);
+assert.equal(sum([0, 100, 0, 200]), 300);
+assert.throws(() => sum([-1]), RangeError);
+assert.throws(() => sum([100, -1, 200]), RangeError);
